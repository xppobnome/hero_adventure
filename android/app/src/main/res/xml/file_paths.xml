<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 允许通过 FileProvider 分享/打开 外部存储与内部文件目录下的文件 -->
    <external-path name="external_files" path="." />
    <files-path name="internal_files" path="." />
    <cache-path name="cache" path="." />
    <external-files-path name="external_app_files" path="." />
    <!-- 自动更新：APK 下载到公共下载目录（Download/），安装时需通过 FileProvider 暴露 -->
    <external-path name="external_downloads" path="Download/" />
    <external-files-path name="external_files_download" path="Download/" />
</paths>
